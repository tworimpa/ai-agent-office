{
  "name": "ai-agent-office-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "AI Agent Office의 데스크톱 작업실",
  "author": "AI Agent Office",
  "homepage": "https://github.com/tworimpa/ai-agent-office",
  "repository": {
    "type": "git",
    "url": "https://github.com/tworimpa/ai-agent-office.git"
  },
  "type": "module",
  "desktopName": "ai-agent-office-desktop.desktop",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.mjs",
    "prepare:runtime": "node build-runtime.mjs",
    "package": "npm run prepare:runtime && electron-builder --publish never && node checksum.mjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "playwright": "1.65.1"
  },
  "build": {
    "appId": "dev.aiagentoffice.desktop",
    "productName": "AI Agent Office",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "studio.mjs",
      "preload.cjs",
      "folders-preload.cjs",
      "setup.html",
      "setup.css",
      "setup.js"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "deleteAppDataOnUninstall": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "executableName": "ai-agent-office-desktop",
      "syncDesktopName": true
    },
    "deb": {
      "maintainer": "AI Agent Office <maintainers@users.noreply.github.com>",
      "depends": [
        "fonts-noto-cjk | fonts-nanum",
        "libgtk-3-0t64 | libgtk-3-0",
        "libasound2t64 | libasound2",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  }
}
